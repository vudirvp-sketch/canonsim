; --- component tokens: LineEdit (§10 state set) ------------------------------
LineEdit/font_sizes/font_size = 15
LineEdit/colors/font_color = Color(0.929, 0.929, 0.929, 1)
LineEdit/colors/font_selected_color = Color(0.929, 0.929, 0.929, 1)
