[resource]
; --- semantic tokens: colour primitives by role (§12) ----------------------
Workbench/colors/background_base = Color(0.059, 0.071, 0.094, 1)
Workbench/colors/surface_l1 = Color(0.082, 0.102, 0.133, 1)
Workbench/colors/surface_l2 = Color(0.11, 0.133, 0.176, 1)
Workbench/colors/surface_l3 = Color(0.137, 0.169, 0.22, 1)
Workbench/colors/surface_selected = Color(0.18, 0.165, 0.137, 1)
Workbench/colors/hairline = Color(0.169, 0.2, 0.259, 1)
Workbench/colors/border_field = Color(0.278, 0.325, 0.42, 1)
Workbench/colors/text_primary = Color(0.914, 0.925, 0.953, 1)
Workbench/colors/text_secondary = Color(0.682, 0.714, 0.776, 1)
Workbench/colors/text_muted = Color(0.502, 0.541, 0.612, 1)
Workbench/colors/accent = Color(0.902, 0.639, 0.361, 1)
Workbench/colors/accent_deep = Color(0.784, 0.51, 0.243, 1)
Workbench/colors/accent_soft = Color(0.902, 0.639, 0.361, 0.1)
Workbench/colors/on_accent = Color(0.098, 0.063, 0.024, 1)
Workbench/colors/focus_ring = Color(0.949, 0.741, 0.498, 1)
; --- semantic status colours (§12/§16 — paired with text, never colour-only)
Workbench/colors/status_success = Color(0.475, 0.784, 0.431, 1)
Workbench/colors/status_warning = Color(0.906, 0.69, 0.29, 1)
Workbench/colors/status_error = Color(0.898, 0.451, 0.451, 1)
Workbench/colors/status_info = Color(0.416, 0.69, 0.925, 1)
; --- the authority vocabulary (§16: displayed, never collapsed)
Workbench/colors/authority_canonical = Color(0.659, 0.608, 0.933, 1)
Workbench/colors/authority_observed = Color(0.455, 0.769, 0.847, 1)
Workbench/colors/authority_derived = Color(0.847, 0.776, 0.455, 1)
Workbench/colors/authority_unknown = Color(0.604, 0.639, 0.698, 1)
; --- semantic tokens: type roles (§11; Cyrillic-safe metrics via containers)
Workbench/constants/font_size_page_title = 26
Workbench/constants/font_size_section_title = 20
Workbench/constants/font_size_control = 15
Workbench/constants/font_size_body = 16
Workbench/constants/font_size_secondary = 14
Workbench/constants/font_size_caption = 12
; --- semantic tokens: geometry/spacing (§15 density: authoring = medium)
Workbench/constants/rail_width = 224
Workbench/constants/bar_height = 52
Workbench/constants/status_bar_height = 32
Workbench/constants/space_xs = 4
Workbench/constants/space_s = 8
Workbench/constants/space_m = 12
Workbench/constants/space_l = 16
Workbench/constants/space_xl = 24
; --- semantic tokens: the chrome styleboxes (composition fetches by name)
Workbench/styles/surface = SubResource("sb_surface_l1")
Workbench/styles/bar = SubResource("sb_bar")
Workbench/styles/chip = SubResource("sb_chip")
Workbench/styles/card_user = SubResource("sb_card_user")
; --- component tokens: layout defaults --------------------------------------
BoxContainer/constants/separation = 8
; --- component tokens: Label (body role default) -----------------------------
Label/colors/font_color = Color(0.914, 0.925, 0.953, 1)
Label/font_sizes/font_size = 16
; --- component tokens: Button (§10 state set) --------------------------------
Button/font_sizes/font_size = 15
Button/colors/font_color = Color(0.914, 0.925, 0.953, 1)
Button/colors/font_hover_color = Color(0.914, 0.925, 0.953, 1)
Button/colors/font_pressed_color = Color(0.914, 0.925, 0.953, 1)
Button/colors/font_hover_pressed_color = Color(0.914, 0.925, 0.953, 1)
Button/colors/font_focus_color = Color(0.914, 0.925, 0.953, 1)
Button/colors/font_disabled_color = Color(0.502, 0.541, 0.612, 1)
Button/styles/normal = SubResource("sb_button_normal")
Button/styles/hover = SubResource("sb_button_hover")
Button/styles/pressed = SubResource("sb_button_pressed")
Button/styles/hover_pressed = SubResource("sb_button_hover_pressed")
Button/styles/disabled = SubResource("sb_button_disabled")
Button/styles/focus = SubResource("sb_button_focus")
; --- component tokens: LineEdit (§10 state set) ------------------------------
LineEdit/font_sizes/font_size = 15
LineEdit/colors/font_color = Color(0.914, 0.925, 0.953, 1)
LineEdit/colors/font_selected_color = Color(0.914, 0.925, 0.953, 1)
LineEdit/colors/font_uneditable_color = Color(0.682, 0.714, 0.776, 1)
LineEdit/colors/font_placeholder_color = Color(0.502, 0.541, 0.612, 1)
LineEdit/colors/caret_color = Color(0.902, 0.639, 0.361, 1)
LineEdit/colors/selection_color = Color(0.902, 0.639, 0.361, 0.45)
LineEdit/styles/normal = SubResource("sb_input_normal")
LineEdit/styles/focus = SubResource("sb_input_focus")
LineEdit/styles/readonly = SubResource("sb_input_readonly")
; --- component tokens: the card container (PanelContainer = layer-2 card) ----
PanelContainer/styles/panel = SubResource("sb_card_l2")
