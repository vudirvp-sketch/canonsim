; --- semantic tokens: colour primitives by role (§12) ----------------------
Workbench/colors/background_base = Color(0.02, 0.02, 0.02, 1)
Workbench/colors/surface_l1 = Color(0.043, 0.043, 0.043, 1)
Workbench/colors/surface_l2 = Color(0.075, 0.075, 0.075, 1)
Workbench/colors/surface_l3 = Color(0.106, 0.106, 0.106, 1)
Workbench/colors/surface_selected = Color(0.165, 0.165, 0.165, 1)
Workbench/colors/hairline = Color(0.137, 0.137, 0.137, 1)
Workbench/colors/border_field = Color(0.38, 0.38, 0.38, 1)
Workbench/colors/text_primary = Color(0.929, 0.929, 0.929, 1)
Workbench/colors/text_secondary = Color(0.725, 0.725, 0.725, 1)
Workbench/colors/text_muted = Color(0.545, 0.545, 0.545, 1)
Workbench/colors/accent = Color(0.298, 0.788, 0.651, 1)
Workbench/colors/accent_soft = Color(0.298, 0.788, 0.651, 0.1)
Workbench/colors/on_accent = Color(0.016, 0.067, 0.047, 1)
Workbench/colors/focus_ring = Color(0.51, 0.878, 0.776, 1)
; --- semantic status colours (§12/§16 — paired with text, never colour-only)
Workbench/colors/status_success = Color(0.455, 0.761, 0.486, 1)
Workbench/colors/status_warning = Color(0.902, 0.765, 0.373, 1)
Workbench/colors/status_error = Color(0.898, 0.459, 0.494, 1)
Workbench/colors/status_info = Color(0.435, 0.714, 0.851, 1)
; --- the authority vocabulary (§16: displayed, never collapsed)
Workbench/colors/authority_canonical = Color(0.702, 0.651, 0.91, 1)
Workbench/colors/authority_observed = Color(0.435, 0.78, 0.839, 1)
Workbench/colors/authority_derived = Color(0.863, 0.604, 0.31, 1)
Workbench/colors/authority_unknown = Color(0.565, 0.565, 0.565, 1)
; --- semantic tokens: type roles (§11; Cyrillic-safe metrics via containers)
Workbench/constants/font_size_page_title = 26
Workbench/constants/font_size_section_title = 20
Workbench/constants/font_size_control = 15
Workbench/constants/font_size_body = 16
Workbench/constants/font_size_secondary = 14
Workbench/constants/font_size_caption = 12
; --- semantic tokens: geometry/spacing (§15 density: authoring = medium)
Workbench/constants/rail_width = 224
Workbench/constants/bar_height = 52
Workbench/constants/status_bar_height = 32
Workbench/constants/space_xs = 4
Workbench/constants/space_s = 8
Workbench/constants/space_m = 12
Workbench/constants/space_l = 16
Workbench/constants/space_xl = 24
; --- semantic tokens: the chrome styleboxes (composition fetches by name)
Workbench/styles/surface = SubResource("sb_surface_l1")
Workbench/styles/bar = SubResource("sb_bar")
Workbench/styles/chip = SubResource("sb_chip")
Workbench/styles/chip_busy = SubResource("sb_chip_busy")
Workbench/styles/card_user = SubResource("sb_card_user")
; --- component tokens: layout defaults --------------------------------------
BoxContainer/constants/separation = 8
; --- component tokens: Label (body role default) -----------------------------
Label/colors/font_color = Color(0.929, 0.929, 0.929, 1)
Label/font_sizes/font_size = 16
; --- component tokens: Button (§10 state set) --------------------------------
Button/font_sizes/font_size = 15
Button/colors/font_color = Color(0.929, 0.929, 0.929, 1)
Button/colors/font_hover_color = Color(0.929, 0.929, 0.929, 1)
Button/colors/font_pressed_color = Color(0.929, 0.929, 0.929, 1)
Button/colors/font_hover_pressed_color = Color(0.929, 0.929, 0.929, 1)
Button/colors/font_focus_color = Color(0.929, 0.929, 0.929, 1)
Button/colors/font_disabled_color = Color(0.38, 0.38, 0.38, 1)
Button/styles/normal = SubResource("sb_button_normal")
Button/styles/hover = SubResource("sb_button_hover")
Button/styles/pressed = SubResource("sb_button_pressed")
Button/styles/hover_pressed = SubResource("sb_button_hover_pressed")
Button/styles/disabled = SubResource("sb_button_disabled")
Button/styles/focus = SubResource("sb_button_focus")
; --- component tokens: NavButton (the rail's quiet variation, wb-12) ---------
NavButton/font_sizes/font_size = 15
NavButton/colors/font_color = Color(0.725, 0.725, 0.725, 1)
NavButton/colors/font_hover_color = Color(0.929, 0.929, 0.929, 1)
