[resource]
; --- semantic tokens: colour primitives by role (§12) ----------------------
Workbench/colors/background_base = Color(0.078431, 0.090196, 0.109804, 1)
Workbench/colors/surface_l1 = Color(0.105882, 0.121569, 0.14902, 1)
Workbench/colors/surface_l2 = Color(0.137255, 0.156863, 0.2, 1)
Workbench/colors/surface_l3 = Color(0.168627, 0.192157, 0.239216, 1)
Workbench/colors/surface_selected = Color(0.227451, 0.184314, 0.133333, 1)
Workbench/colors/hairline = Color(0.2, 0.227451, 0.278431, 1)
Workbench/colors/border_field = Color(0.415686, 0.462745, 0.533333, 1)
Workbench/colors/text_primary = Color(0.901961, 0.913725, 0.937255, 1)
Workbench/colors/text_secondary = Color(0.662745, 0.694118, 0.745098, 1)
Workbench/colors/text_muted = Color(0.541176, 0.576471, 0.635294, 1)
Workbench/colors/accent = Color(0.85098, 0.627451, 0.4, 1)
Workbench/colors/accent_deep = Color(0.752941, 0.541176, 0.309804, 1)
Workbench/colors/on_accent = Color(0.078431, 0.090196, 0.109804, 1)
Workbench/colors/focus_ring = Color(0.909804, 0.721569, 0.466667, 1)
; --- semantic status colours (§12/§16 — paired with text, never colour-only)
Workbench/colors/status_success = Color(0.52549, 0.741176, 0.427451, 1)
Workbench/colors/status_warning = Color(0.886275, 0.701961, 0.305882, 1)
Workbench/colors/status_error = Color(0.858824, 0.439216, 0.439216, 1)
Workbench/colors/status_info = Color(0.454902, 0.658824, 0.870588, 1)
; --- the authority vocabulary (§16: displayed, never collapsed)
Workbench/colors/authority_canonical = Color(0.658824, 0.607843, 0.960784, 1)
Workbench/colors/authority_observed = Color(0.454902, 0.768627, 0.847059, 1)
Workbench/colors/authority_derived = Color(0.847059, 0.776471, 0.454902, 1)
Workbench/colors/authority_unknown = Color(0.603922, 0.639216, 0.698039, 1)
; --- semantic tokens: type roles (§11; Cyrillic-safe metrics via containers)
Workbench/constants/font_size_page_title = 24
Workbench/constants/font_size_section_title = 19
Workbench/constants/font_size_control = 15
Workbench/constants/font_size_body = 16
Workbench/constants/font_size_secondary = 14
Workbench/constants/font_size_caption = 12
; --- semantic tokens: geometry/spacing (§15 density: authoring = medium)
Workbench/constants/rail_width = 208
Workbench/constants/bar_height = 44
Workbench/constants/status_bar_height = 30
Workbench/constants/space_xs = 4
Workbench/constants/space_s = 8
Workbench/constants/space_m = 12
Workbench/constants/space_l = 16
Workbench/constants/space_xl = 24
; --- semantic tokens: the chrome styleboxes (composition fetches by name)
Workbench/styles/surface = SubResource("sb_surface_l1")
Workbench/styles/bar = SubResource("sb_bar")
; --- component tokens: layout defaults --------------------------------------
BoxContainer/constants/separation = 8
; --- component tokens: Label (body role default) -----------------------------
Label/colors/font_color = Color(0.901961, 0.913725, 0.937255, 1)
Label/font_sizes/font_size = 16
; --- component tokens: Button (§10 state set) --------------------------------
Button/font_sizes/font_size = 15
Button/colors/font_color = Color(0.901961, 0.913725, 0.937255, 1)
Button/colors/font_hover_color = Color(0.901961, 0.913725, 0.937255, 1)
Button/colors/font_pressed_color = Color(0.901961, 0.913725, 0.937255, 1)
Button/colors/font_hover_pressed_color = Color(0.901961, 0.913725, 0.937255, 1)
Button/colors/font_focus_color = Color(0.901961, 0.913725, 0.937255, 1)
Button/colors/font_disabled_color = Color(0.541176, 0.576471, 0.635294, 1)
Button/styles/normal = SubResource("sb_button_normal")
Button/styles/hover = SubResource("sb_button_hover")
Button/styles/pressed = SubResource("sb_button_pressed")
Button/styles/hover_pressed = SubResource("sb_button_hover_pressed")
Button/styles/disabled = SubResource("sb_button_disabled")
Button/styles/focus = SubResource("sb_button_focus")
; --- component tokens: LineEdit (§10 state set) ------------------------------
LineEdit/font_sizes/font_size = 15
LineEdit/colors/font_color = Color(0.901961, 0.913725, 0.937255, 1)
LineEdit/colors/font_selected_color = Color(0.901961, 0.913725, 0.937255, 1)
LineEdit/colors/font_uneditable_color = Color(0.662745, 0.694118, 0.745098, 1)
LineEdit/colors/font_placeholder_color = Color(0.541176, 0.576471, 0.635294, 1)
LineEdit/colors/caret_color = Color(0.85098, 0.627451, 0.4, 1)
LineEdit/colors/selection_color = Color(0.85098, 0.627451, 0.4, 0.45)
LineEdit/styles/normal = SubResource("sb_input_normal")
LineEdit/styles/focus = SubResource("sb_input_focus")
LineEdit/styles/readonly = SubResource("sb_input_readonly")
; --- component tokens: the card container (PanelContainer = layer-2 card) ----
PanelContainer/styles/panel = SubResource("sb_card_l2")
