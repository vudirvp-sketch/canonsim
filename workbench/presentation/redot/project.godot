; CanonSim Workbench — the wb seam proof project (CONTRACTS.md §5, D-200).
; Pinned engine line: Redot 26.2 LTS (redot-26.2-stable) — the binary is an
; EXTERNAL toolchain (one REDOT_EXE path), never committed; this directory
; commits the project only. Renderer baseline: gl_compatibility (the brief's
; integration contract §2). The engine cache lands in .godot/ (gitignored).

config_version=5

[application]

config/name="CanonSimWorkbench"
config/description="CanonSim Workbench - the application shell (wb-2/wb-7: the live chat circuit over the loopback gateway) over the wb-1 vertical seam proof (Visual Scene IR -> placeholder composition -> screenshot artifact)"
run/main_scene="res://scenes/shell.tscn"
config/features=PackedStringArray("GL Compatibility")

[canonism_workbench]

; The live circuit's default gateway URL (wb-7): the shell resolves
; --gateway-url (user arg) > CANONSIM_GATEWAY_URL (env) > THIS setting.
; The default matches scripts/workbench_app.py's own loopback default.
gateway/url="http://127.0.0.1:8765"

[display]

; ux-1 — the viewport/min-size policy (FRONTEND_UIUX_LAW §16): the base
; stays 1440x900 (MEDIUM/LARGE); the floor 1152x700 keeps the three-region
; layout usable at SMALL; stretch canvas_items + expand scales content with
; the window (no critical clipping at any viewport class, extra space fills
; the content region — the anchored containers own the layout).
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/min_width=1152
window/size/min_height=700
window/size/stretch/mode="canvas_items"
window/size/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
