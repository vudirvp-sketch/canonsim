static func lookup(key: String, locale: String) -> String:
        # The honest fallback: a missing key returns the key itself — visible
        # in review, never a silently wrong string (the boundary's own law).
        var catalog: Dictionary = RU if locale == "ru" else EN
        if catalog.has(key):
                return String(catalog[key])
        return key


static func locales() -> PackedStringArray:
        return PackedStringArray(["en", "ru"])
