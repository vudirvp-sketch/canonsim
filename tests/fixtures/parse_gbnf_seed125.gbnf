root ::= intent-doc | question-doc | no-intent-doc
intent-doc ::= "{\"intent\": {" verb-body "}}"
verb-body ::= verb-look-around | verb-examine | verb-move | verb-talk | verb-wait | verb-take | verb-drop-break | verb-use | verb-steal | verb-distract | verb-arson | verb-rest | verb-document-check | verb-coerce | verb-flee | verb-ramble
question-doc ::= "{\"question\": " string "}"
no-intent-doc ::= "{\"no_intent\": " string "}"
string ::= "\"" string-char ( string-char )* "\""
string-char ::= [^"\\\x7F\x00-\x1F] | "\\" ( ["\\bfnrt] | "u" hex hex hex hex )
hex ::= [0-9a-fA-F]
positive-int ::= [1-9] [0-9]*
canon-target ::= "\"loc_tavern\"" | "\"loc_street\"" | "\"loc_backyard\"" | "\"loc_guardroom\"" | "\"loc_market\"" | "\"pc_01\"" | "\"npc_guard_01\"" | "\"npc_guard_02\"" | "\"npc_barkeep_01\"" | "\"npc_drunk_01\"" | "\"npc_maid_01\"" | "\"npc_market_crowd_01\"" | "\"oil_lamp_01\"" | "\"purse_01\"" | "\"ale_mug_01\"" | "\"club_01\"" | "\"rope_01\""
verb-look-around ::= "\"kind\": \"look_around\", \"target\": "( "null" | canon-target )", \"fields\": {}"
verb-examine ::= "\"kind\": \"examine\", \"target\": "canon-target", \"fields\": {}"
verb-move ::= "\"kind\": \"move\", \"target\": "canon-target", \"fields\": {}"
verb-talk ::= "\"kind\": \"talk\", \"target\": "canon-target", \"fields\": {}"
verb-wait ::= "\"kind\": \"wait\", \"target\": "( "null" | canon-target )", \"fields\": {\"ticks\": "positive-int"}"
verb-take ::= "\"kind\": \"take\", \"target\": "canon-target", \"fields\": {}"
verb-drop-break ::= "\"kind\": \"drop_break\", \"target\": "canon-target", \"fields\": {}"
verb-use ::= "\"kind\": \"use\", \"target\": "canon-target", \"fields\": {}"
verb-steal ::= "\"kind\": \"steal\", \"target\": "canon-target", \"fields\": "( "{}" | "{\"method\": \"distraction\"}" )
verb-distract ::= "\"kind\": \"distract\", \"target\": "canon-target", \"fields\": {}"
verb-arson ::= "\"kind\": \"arson\", \"target\": "canon-target", \"fields\": {}"
verb-rest ::= "\"kind\": \"rest\", \"target\": "( "null" | canon-target )", \"fields\": {}"
verb-document-check ::= "\"kind\": \"document_check\", \"target\": "canon-target", \"fields\": {}"
verb-coerce ::= "\"kind\": \"coerce\", \"target\": "canon-target", \"fields\": {}"
verb-flee ::= "\"kind\": \"flee\", \"target\": "canon-target", \"fields\": {}"
verb-ramble ::= "\"kind\": \"ramble\", \"target\": "( "null" | canon-target )", \"fields\": {}"
