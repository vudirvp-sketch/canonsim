          "proposal": {
            "expected_event_seq": "anchor",
            "claims": [
              {"kind": "state", "entity": "pc_01", "prop": "position", "value": "loc_tavern"},
              {"kind": "event", "event_id": "ev_0000", "type": "move"}
            ]
          }
        }}
      ],
      "expect": {"status": "accepted", "notes_contains": ["BEAT claims: 2 supported"]}
    },
